# ─── ILU SHOP — Variables d'environnement ───────────────────────────────────
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais committer .env.local (il est dans .gitignore).

# ── Pipeline IA Images ───────────────────────────────────────────────────────

# Remove.bg — Détourage automatique (suppression de fond)
# Obtenir une clé : https://www.remove.bg/api
# Tier gratuit : 50 appels/mois. Tier pro : à partir de $9/mois.
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Replicate — Upscale IA (Real-ESRGAN ×2 ou ×4)
# Obtenir un token : https://replicate.com/account/api-tokens
# Facturation à l'usage (~$0.0023 par upscale).
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ── SasPay — paiement Mobile Money / carte ───────────────────────────────────
# En production, ces valeurs viennent de apphosting.yaml (secrets Google Cloud).
# Clé secrète de l'application ILU SHOP (portée « Encaissement » suffit). Serveur uniquement.
SASPAY_SECRET_KEY=
SASPAY_API_BASE=https://api.saspay.me/api/v1
# Secret affiché UNE SEULE FOIS à la création du webhook dans le tableau de bord SasPay
# (adresse : https://<domaine>/api/saspay/webhook).
SASPAY_WEBHOOK_SECRET=
# Interrupteur : vide/false = seuls les admins voient le paiement en ligne (paiement d'essai).
SASPAY_ENABLED=
# Optionnel : planificateur externe pour POST /api/payments/reconcile (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ── Firebase Admin SDK (routes de paiement) — en LOCAL seulement ────────────
# En production (App Hosting), l'identité du service suffit : rien à configurer.
# En local, au choix : `gcloud auth application-default login`
# ou le JSON d'un compte de service (Console Firebase → Paramètres → Comptes de service), sur une ligne :
FIREBASE_SERVICE_ACCOUNT_KEY=
